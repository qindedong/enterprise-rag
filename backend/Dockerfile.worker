# ============================================================
# 企业级知识库 RAG — Worker 镜像（基于 rag-api 共享构建）
# ============================================================
# Worker 与 API 的 Python 依赖完全相同（worker 依赖是 API 的子集），
# 因此直接复用 rag-api 镜像的全部层：
#   - 构建时间从 ~25 分钟降至秒级
#   - 磁盘占用从 2 × 8.9GB 降至 8.9GB + 一个代码层（层共享）
#
# 前置条件（必须先构建 API 镜像）:
#   docker build -t rag-api:latest -f backend/Dockerfile .
# 构建命令:
#   docker build -t rag-worker:latest -f backend/Dockerfile.worker backend/
# ============================================================

FROM rag-api:latest

# 健康检查与端口暴露对 Worker 不适用，覆盖掉
HEALTHCHECK NONE

# Worker 启动命令（从 Redis 队列取任务）
CMD ["python", "-m", "app.worker"]
